# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/matchpredic
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/matchpredic

# ── Application ────────────────────────────────────────
DEBUG=false

# ── Scraping rate limits (seconds) ────────────────────
SCRAPE_DELAY_MIN=2.0
SCRAPE_DELAY_MAX=5.0

# ── ML model storage ─────────────────────────────────
MODEL_DIR=ml_models

# ── FBref (Cloudflare Turnstile) ───────────────────────
# Scrape.do: JS-rendered requests; datacenter often works (SCRAPE_DO_SUPER=false).
# https://scrape.do/documentation
# SCRAPE_DO_TOKEN=
# SCRAPE_DO_SUPER=false

# ── Alternative: ScrapingBee ───────────────────────────
# SCRAPING_API_KEY=
# SCRAPING_API_URL=https://app.scrapingbee.com/api/v1/

# ── Other ─────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# ODDS_API_KEY=
# FOOTBALL_API_KEY=
